<?xml version="1.0" encoding="utf-8"?>
<duixml>
	<stylesheets>
		<style resid="sidebarSheet">
			<element font="gtf(TEXTSTYLE, 4, 0)" background="window" />
            <Edit transparent="true" themedborder="true" font="gtf(TEXTSTYLE, 4, 0)" foreground="windowtext" />

			<if class="sidebarPiece">
				<element borderthickness="rect(0rp,0rp,1rp,0rp)"
						bordercolor="threedlightshadow" />
			</if>

            <if class="sidebarPieceHeader">
				<element borderthickness="rect(0rp,0rp,0rp,1rp)"
						bordercolor="threedlightshadow" />
			</if>

            <if class="sidebarPieceSearch">
				<element borderthickness="rect(0rp,0rp,0rp,1rp)"
						bordercolor="threedlightshadow" />
			</if>

            <if class="sidebarFirstPieceDirect">
				<element borderthickness="rect(0rp,0rp,1rp,0rp)"
						bordercolor="threedlightshadow" />
			</if>
		</style>
	</stylesheets>
	
	<HWNDElement resid="sidebarPieceMain" id="atom(root)" layout="borderlayout()" sheet="sidebarSheet">

        <element layoutpos="client" class="sidebarPiece" layout="borderlayout()">
            <!-- The Messages / Servers tabs and the chat list are WinForms controls now (see Client.Designer.vb):
                 DirectUI could neither scroll the list nor tell which row was clicked. Only the search box stays here. -->
            <element layoutpos="top" class="sidebarPieceSearch" height="30rp" layout="borderlayout()">

                <element layoutpos="client" padding="rect(8rp, 5rp, 8rp, 5rp)" layout="borderlayout()">
                    <edit id="atom(searchBox)" layoutpos="client"
					    accessible="true" accrole="text" accname="Search bar for NaticordVB" />
                </element>

            </element>
        </element>

	</HWNDElement>
</duixml>